# ═══════════════════════════════════════════════════════════════════════
# Avatar Platform — Environment Configuration
# Copy to .env and fill in your values
# ═══════════════════════════════════════════════════════════════════════

# ─── Application ──────────────────────────────────────────────────────
APP_NAME=AvatarPlatform
APP_ENV=development
APP_VERSION=1.0.0
DEBUG=false
LOG_LEVEL=INFO

# ─── Security (REQUIRED — generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=CHANGE_ME_GENERATE_RANDOM_32_BYTE_HEX
JWT_SECRET_KEY=CHANGE_ME_GENERATE_RANDOM_32_BYTE_HEX
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ─── Database ─────────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=avatarplatform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_SECURE_PASSWORD
DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME@postgres:5432/avatarplatform

# ─── Redis ────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ─── MinIO Storage ────────────────────────────────────────────────────
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=CHANGE_ME_MINIO_SECRET
MINIO_SECURE=false
MINIO_BUCKET_AVATARS=avatars
MINIO_BUCKET_VOICES=voices
MINIO_BUCKET_VIDEOS=videos
MINIO_BUCKET_DOCUMENTS=documents

# ─── Qdrant Vector DB ─────────────────────────────────────────────────
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# ─── AI/LLM Providers ─────────────────────────────────────────────────
# At least one LLM provider is required
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# Local LLM via Ollama (optional)
OLLAMA_BASE_URL=http://ollama:11434

# Primary LLM configuration
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini

# ─── AI Model Paths ───────────────────────────────────────────────────
MODEL_DIR=/app/models
LIVEPORTRAIT_MODEL_PATH=/app/models/liveportrait
MUSETALK_MODEL_PATH=/app/models/musetalk
WAV2LIP_MODEL_PATH=/app/models/wav2lip
INSIGHTFACE_MODEL_PATH=/app/models/insightface
WHISPER_MODEL_SIZE=large-v3
WHISPER_MODEL_PATH=/app/models/whisper
XTTS_MODEL_PATH=/app/models/xtts-v2
EMBEDDER_MODEL_PATH=/app/models/embedder

# Primary animation engine: liveportrait | wav2lip
ANIMATION_ENGINE=liveportrait

# Primary TTS engine: xtts | cosyvoice | f5tts
TTS_ENGINE=xtts

# ─── CORS ─────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# ─── GPU Configuration ────────────────────────────────────────────────
CUDA_VISIBLE_DEVICES=0
TORCH_DEVICE=cuda

# ─── Monitoring (Optional) ────────────────────────────────────────────
SENTRY_DSN=

# ─── Email (Optional — for notifications) ─────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@avatarplatform.com

# ─── Backup (Optional) ────────────────────────────────────────────────
BACKUP_ENCRYPTION_KEY=
S3_BACKUP_BUCKET=

# ─── Feature Flags ────────────────────────────────────────────────────
ENABLE_REALTIME=true
ENABLE_4K_RENDERING=false
ENABLE_VOICE_CLONING=true
ENABLE_KNOWLEDGE_BASE=true
MAX_UPLOAD_SIZE_MB=500
MAX_VIDEO_DURATION_MINUTES=30
